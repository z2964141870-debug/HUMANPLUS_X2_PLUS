{
  "schema": "x2_phase6_reset_bridge_prereg_v1",
  "date": "2026-08-11",
  "hypothesis": "The Phase30 frame-0 state is not a valid X2 reset because its official sole spheres already penetrate the floor. A one-shot constrained initial-state projection followed by a fixed short bridge may isolate this reset artifact from later dynamic infeasibility.",
  "inputs": {
    "motion_key": "PHUMA-LUNGE-R-001",
    "prefix_s": 0.34,
    "control_hz": 50,
    "physics_hz": 1000,
    "model": "official raw torque-motor scene.xml",
    "pd": "official motion_control.yaml"
  },
  "projection": {
    "solver": "scipy.optimize.SLSQP",
    "single_run": true,
    "maxiter": 500,
    "ftol": 1e-12,
    "variables": ["root_x", "root_y", "root_z", "left_leg_6dof", "right_leg_6dof", "waist_3dof"],
    "root_bounds_from_reference_m": {"xy": 0.05, "z": 0.08},
    "joint_bounds": "intersection(model joint limits, reference +/- 0.35 rad)",
    "velocity_reset": "all qvel = 0 (explicit reset convention)",
    "constraints": {
      "all_official_collidable_sole_spheres_clearance_m_min": -0.0005,
      "each_foot_min_clearance_m_max": -0.00005
    },
    "objective": "fixed normalized root displacement + 15-DoF displacement + upper-body world-keypoint displacement"
  },
  "bridge": {
    "single_configuration": true,
    "formula": "q_target(t) = q_ref(t) + (1-smoothstep(t/0.34))*delta_q_projected",
    "head_target_rad": 0.0,
    "torque": "clip(kp*(q_target-q)-kd*dq, official motor ctrlrange)"
  },
  "gates": {
    "projection_solver_success": true,
    "projection_nonpenetration_mm": -0.5,
    "projection_effective_contact_each_foot": true,
    "survive_full_prefix": true,
    "dynamic_penetration_min_mm": -0.5,
    "stance_speed_p95_mps": 0.10,
    "stance_excursion_max_m": 0.03,
    "unintended_flight_fraction": 0.02,
    "root_horiz_accel_p95_mps2": 4.0,
    "head_q_max_abs_rad": 0.02
  },
  "prohibitions": ["no Phase3-5 edits", "no parameter scan", "no second solver configuration", "no RL/PPO"],
  "stop": "Report the one projection and one bridge replay honestly, then stop."
}
